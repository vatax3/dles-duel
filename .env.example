# Les joueurs se gèrent dans l'app (Réglages → Joueurs) : rien à configurer ici.

# Facultatif : code commun demandé une fois par appareil pour entrer sur le site.
# Vide = accès libre (déconseillé si l'app est exposée sur Internet).
ACCESS_CODE=

# Fuseau pour « aujourd'hui » côté serveur (partage Android / raccourci iOS)
TZ=Europe/Paris

# URL publique (utilisée dans les notifications), ex : https://duel.mondomaine.fr
PUBLIC_URL=

# Notifications quand quelqu'un poste ses scores (laisser vide pour désactiver) :
#  - ntfy    : https://ntfy.sh/mon-topic-secret  (ou ton instance ntfy)
#  - Discord : https://discord.com/api/webhooks/…
#  - Slack   : https://hooks.slack.com/services/…
NOTIFY_URL=
NOTIFY_DELAY_SECONDS=90

# Mettre true si l'app est servie en HTTPS sans en-tête X-Forwarded-Proto
COOKIE_SECURE=false

# Facultatif : secret de signature (sinon généré dans /data/secret)
# SECRET=

# Ancienne config : si la base n'a encore aucun joueur, ceux-ci sont créés au démarrage (id:Nom)
# PLAYERS=val:Val,pips:Pips
